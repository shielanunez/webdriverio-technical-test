{
  "name": "webdriverio-technical-test",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:headless": "HEADLESS=true wdio run wdio.conf.js",
    "test:web": "wdio run wdio.conf.js --spec test/specs/web",
    "test:api": "wdio run wdio.conf.js --spec test/specs/api",
    "test:web:headless": "HEADLESS=true wdio run wdio.conf.js --spec test/specs/web",
    "test:api:headless": "HEADLESS=true wdio run wdio.conf.js --spec test/specs/api",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open" 
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.31.4",
    "@wdio/cli": "^9.31.9",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.2",
    "chai": "^6.2.2",
    "chromedriver": "^152.0.3"
  }
}